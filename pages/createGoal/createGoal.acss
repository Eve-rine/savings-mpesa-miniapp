.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 16px;
  background-color: #FFFFFF;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.header-title {
  font-size: 20px;
  font-weight: 600;
}

.back-button {
  padding: 8px;
}

.form {
  flex: 1;
}

.input-group {
  margin-bottom: 20px;
}

.input-label {
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
  display: block;
}

.input {
  width: 100%;
  height: 48px;
  padding: 0 16px;
  font-size: 16px;
  background-color: #F7F7F7;
  border-radius: 8px;
  box-sizing: border-box;
}

/* Picker styling */
.picker {
  background-color: #F7F7F7;
  border-radius: 8px;
  height: 48px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 16px;
  color: #333;
}

/* Style for placeholder text in pickers */
.picker text:first-child {
  color: #999;
}

/* Upload button styling */
.upload-button {
  background-color: #F7F7F7;
  border-radius: 8px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #666;
  border: 1px dashed #CCCCCC;
}

.upload-button-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  margin-bottom: 4px;
}

/* Image preview styling */
.image-preview {
  width: 100%;
  height: 120px;
  border-radius: 8px;
  margin-top: 8px;
  background-color: #F7F7F7;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 8px;
  object-fit: cover;
}

.remove-image {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.button-group {
  margin-top: 24px;
  padding-bottom: 16px;
}

.primary-button {
  height: 48px;
  border-radius: 24px;
  background-color: #F9B659;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 16px;
  font-weight: 500;
}

.disabled-button {
  opacity: 0.6;
  pointer-events: none;
}