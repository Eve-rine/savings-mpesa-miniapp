.motivation-tip {
  margin: 16px 0 24px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
}

.tip-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 8px;
}

.tip-content {
  font-size: 14px;
  color: #666;
  line-height: 1.5;
}